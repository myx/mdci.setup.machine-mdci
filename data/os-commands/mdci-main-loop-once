#!/bin/sh

##
## Runs exactly one main-loop iteration and returns its status. A work command,
## not a check: it is here so a sudoers.d glob can delegate it and so monit can
## invoke it, which is what everything in this directory is for. Whether the rig
## is good is answered by `mdci-status` and by the monit rule, not by this.
##

set -e

MDCI_HOME="${MDCI_HOME:-/usr/local/mdci}"
## The workspace is workspace.mdci in the home, found by that path.
MDCI_WORKSPACE="$MDCI_HOME/workspace.mdci"

exec "$MDCI_WORKSPACE/.local/myx/myx.distro-agents/sh-scripts/DistroAgentsTools.fn.sh" --intern-main-loop --one
