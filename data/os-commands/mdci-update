#!/bin/sh

##
## Upgrades the rig's installed tooling to the latest versions, as the rig
## account, so everything it writes under .local stays owned by that account and
## the daemon can read it. The account runs it itself and root is run as the
## account; no sudo rule is needed for either, and nobody else may run it.
##

set -e

MDCI_HOME="${MDCI_HOME:-/usr/local/mdci}"
MDCI_USER="$( sysrc -n mdcid_user 2>/dev/null || echo mdci )"
## The workspace is workspace.mdci in the home, found by that path.
MDCI_WORKSPACE="$MDCI_HOME/workspace.mdci"

if [ "$( id -u )" = 0 ] ; then
	exec sudo -u "$MDCI_USER" -H "$0" "$@"
fi

if [ "$( id -un )" != "$MDCI_USER" ] ; then
	echo "⛔ ERROR: mdci-update: only root and the account $MDCI_USER can run it" >&2
	exit 1
fi

## The tool finds its workspace from its own path, as it does when root starts it; a console's variables must not move it.
cd /
exec env -u MMDAPP -u MDLT_ORIGIN "$MDCI_WORKSPACE/.local/myx/myx.distro-.local/sh-scripts/DistroLocalTools.fn.sh" --upgrade-installed-tools
